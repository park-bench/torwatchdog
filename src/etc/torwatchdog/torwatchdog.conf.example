# torwatchdog.conf.example
# Example configuration for torwatchdog.

[General]

# Specifies the verbosity of the program's log. Valid values are CRITICAL, ERROR, WARNING,
#   INFO, DEBUG, and TRACE. This value is case insensitive.
log_level=info

# The URL that torwatchdog checks.
url=

# Tor will listen on this port. (Default randomly chosen by developer.) This value must match
#   the value in /etc/tor/instances/torwatchdogtor/torrc.
tor_socks_port=6613

# Maximum delay in seconds between URL polling attempts. The delay between URL polling
#   attempts (in seconds) is randomly selected between 0 and this value. Cannot be greater
#   than 900.
max_poll_delay=300

# The minimum number of subsequent failed polls before the email alert is sent. Must be 1 or
#   greater.
min_failed_polls=3

# Optional subject line, an arbitary string. Subject lines are NOT encrypted.
email_subject=
